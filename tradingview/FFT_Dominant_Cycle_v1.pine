// ══════════════════════════════════════════════════════════════════════════════
// FFT DOMINANT CYCLE  [Pipeline Bot #11]
// ══════════════════════════════════════════════════════════════════════════════
// Implementazione della Discrete Fourier Transform (DFT) rolling su log-return
// con window di Hann per rilevare il ciclo dominante del mercato.
//
// Logica (identica al backtest Python):
//   1. Su una finestra rolling N di log-return, applica la Hann window
//   2. Calcola la DFT per i bin nella banda media (escluse basse freq = trend,
//      alte freq = rumore)
//   3. Bin dominante = max energia nella banda
//   4. Ciclo ricostruito = (2/N) * Re(X[k_max])
//   5. Segnale LONG  quando lo slope del ciclo supera 0 dal basso (trough)
//   6. Segnale SHORT quando lo slope del ciclo scende sotto 0 dall'alto (peak)
//   7. Quality filter: SNR >= min_snr  AND  dom_period >= min_period barre
//   8. Session filter opzionale (London 07-16 UTC, Asian 00-08, NY 13-21)
//
// Backtest di riferimento (EURUSD M15, Train 2020, OOS 2021-2025):
//   Best: N=256, low=10%, high=20%, min_period=10b, London → OOS PF=1.173, DD=16%
//   (N=64 in Pine per performance; N=256 richiede run locale in Python)
//
// ⚠️  NOTA PERFORMANCE:
//   Con N=64 l'indicatore esegue ~1500 ops/barra (float) — OK su chart normali.
//   Se il chart è lento, riduci N a 32 o aumenta il timeframe.
//
// @version=6
// ══════════════════════════════════════════════════════════════════════════════

//@version=6
indicator("FFT Dominant Cycle  [Pipeline Bot #11]",
     shorttitle = "FFT-DC",
     overlay    = false,
     max_bars_back = 512,
     timeframe_gaps = false)

// ─────────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────────
var GRP_DFT  = "◆ DFT Parameters"
var GRP_SIG  = "◆ Signal Filters"
var GRP_SESS = "◆ Session Filter"
var GRP_VIS  = "◆ Visual"

int   N          = input.int   (64,   "FFT Window (bars)",
     minval=16, maxval=128, step=16, group=GRP_DFT,
     tooltip="Barre della finestra rolling. 64 = standard. Aumentare per catturare cicli più lunghi (>128 lento).")

float low_pct    = input.float (0.10, "Low Freq Cutoff  (0–0.20)",
     minval=0.02, maxval=0.20, step=0.01, group=GRP_DFT,
     tooltip="Frazione di bin a bassa frequenza da escludere (rimozione trend). Corrispondente a Python low_pct.")

float high_pct   = input.float (0.20, "High Freq Cutoff (0.10–0.50)",
     minval=0.10, maxval=0.50, step=0.05, group=GRP_DFT,
     tooltip="Frazione di bin ad alta frequenza da escludere (rimozione rumore).")

int   min_period = input.int   (10,   "Min Cycle Period (bars)",
     minval=3, maxval=48, group=GRP_SIG,
     tooltip="Periodo minimo del ciclo dominante in barre. Filtra i cicli troppo brevi = rumore.")

float min_snr    = input.float (1.5,  "Min SNR Threshold",
     minval=0.5, maxval=6.0, step=0.1, group=GRP_SIG,
     tooltip="Rapporto segnale/rumore del bin dominante vs media della banda. SNR < 1.5 = segnale debole.")

string sess_mode = input.string("London", "Session Filter",
     options=["London (07-16 UTC)", "New York (13-21 UTC)", "Asian (00-08 UTC)", "All Day", "Off"],
     group=GRP_SESS)

bool   show_period = input.bool(true,  "Show Dominant Period line", group=GRP_VIS)
bool   show_snr    = input.bool(false, "Show SNR line",             group=GRP_VIS)
bool   show_bg     = input.bool(true,  "Session background shade",  group=GRP_VIS)
color  bull_col    = input.color(#00c853, "Bull Color", group=GRP_VIS)
color  bear_col    = input.color(#d32f2f, "Bear Color", group=GRP_VIS)
color  neut_col    = input.color(#607d8b, "Neutral/Weak Color", group=GRP_VIS)

// ─────────────────────────────────────────────────────────────────────────────
//  SESSION
// ─────────────────────────────────────────────────────────────────────────────
int h_utc = hour(time, "UTC")

bool in_london  = h_utc >= 7  and h_utc < 16
bool in_newyork = h_utc >= 13 and h_utc < 21
bool in_asian   = h_utc >= 0  and h_utc < 8

bool in_session = switch sess_mode
    "London (07-16 UTC)"   => in_london
    "New York (13-21 UTC)" => in_newyork
    "Asian (00-08 UTC)"    => in_asian
    "All Day"              => true
    "Off"                  => true
    => true

// ─────────────────────────────────────────────────────────────────────────────
//  LOG RETURN
// ─────────────────────────────────────────────────────────────────────────────
float lr = bar_index > 0 ? math.log(close / close[1]) : 0.0

// ─────────────────────────────────────────────────────────────────────────────
//  DFT COMPUTATION
//  Computa la DFT della finestra rolling di N log-return con Hann window.
//  Cerca il bin con massima potenza nella banda [low_b, high_b].
//  Ricostruisce il valore del ciclo dominante al bar corrente:
//    cycle = (2/N) * xr_kmax
//  dove xr_kmax = Re(X[k_max]) = Σ hann[i] * lr[i] * cos(2π*k*i/N)
//  e lr[0] = bar corrente, lr[N-1] = N-1 barre fa (Pine notation)
// ─────────────────────────────────────────────────────────────────────────────

// Bin boundaries
int n_bins = N / 2 + 1
int low_b  = math.max(1, int(n_bins * low_pct))
int high_b = math.min(n_bins - 1, int(n_bins * (1.0 - high_pct)))
int n_band = math.max(1, high_b - low_b)

// Output variables
var float dom_cycle  = na
var float dom_period = na
var float snr_out    = na

if bar_index >= N - 1
    float max_power      = 0.0
    int   k_max          = low_b
    float xr_max         = 0.0
    float band_power_sum = 0.0

    for k = low_b to high_b
        float two_pi_k_N = 2.0 * math.pi * k / N
        float xr = 0.0
        float xi = 0.0

        for i = 0 to N - 1
            // Hann window: simmetrica, i=0 (corrente) e i=N-1 (oldest) → peso 0
            // Picco al centro della finestra (i ≈ N/2) → peso 1
            float w = 0.5 * (1.0 - math.cos(2.0 * math.pi * i / (N - 1)))
            float s = nz(lr[i]) * w
            xr +=  s * math.cos(two_pi_k_N * i)
            xi -=  s * math.sin(two_pi_k_N * i)  // segno negativo: DFT standard e^(-j...)

        float pwr = xr * xr + xi * xi
        band_power_sum += pwr

        if pwr > max_power
            max_power := pwr
            k_max     := k
            xr_max    := xr

    // Periodo dominante in barre
    dom_period := float(N) / math.max(k_max, 1)

    // SNR: potenza bin dominante vs media di banda
    float mean_band = band_power_sum / n_band
    snr_out := max_power / math.max(mean_band, 1e-30)

    // Valore del ciclo ricostruito al bar corrente
    // Nota: (2/N)*xr_max ≈ ampiezza_ciclo * cos(fase_corrente)
    dom_cycle := (2.0 / N) * xr_max

// ─────────────────────────────────────────────────────────────────────────────
//  SEGNALI
// ─────────────────────────────────────────────────────────────────────────────

// Quality gate (specchio del Python backtest)
bool quality = not na(dom_cycle)
         and not na(snr_out)
         and snr_out    >= min_snr
         and dom_period >= min_period

// Slope del ciclo (derivata discreta)
float slope      = nz(dom_cycle) - nz(dom_cycle[1])
float slope_prev = nz(slope[1])

// Zero-crossing dello slope: identico al Python
// Long  = slope appena diventato positivo (trough del ciclo)
// Short = slope appena diventato negativo (peak del ciclo)
bool long_raw  = slope > 0 and slope_prev <= 0
bool short_raw = slope < 0 and slope_prev >= 0

bool long_sig  = long_raw  and quality and in_session
bool short_sig = short_raw and quality and in_session

// ─────────────────────────────────────────────────────────────────────────────
//  NORMALIZZAZIONE per il plot
// ─────────────────────────────────────────────────────────────────────────────
// Normalizza il ciclo a [-1, +1] usando il max assoluto su 2×N barre
float abs_cycle  = math.abs(nz(dom_cycle))
float max_abs    = ta.highest(abs_cycle, N * 2)
float cycle_norm = max_abs > 0 ? dom_cycle / max_abs : 0.0

// Colore del ciclo: verde se in rialzo, rosso se in ribasso, grigio se bassa qualità
color cycle_color = not quality ? neut_col
     : cycle_norm > 0           ? color.new(bull_col, 20)
     :                            color.new(bear_col, 20)

// ─────────────────────────────────────────────────────────────────────────────
//  BACKGROUND — sessione attiva
// ─────────────────────────────────────────────────────────────────────────────
bool show_bg_cond = show_bg and sess_mode != "Off" and sess_mode != "All Day"
color bg_col = switch sess_mode
    "London (07-16 UTC)"   => color.new(#1565c0, 90)
    "New York (13-21 UTC)" => color.new(#6a1b9a, 90)
    "Asian (00-08 UTC)"    => color.new(#e65100, 90)
    => na
bgcolor(show_bg_cond and in_session ? bg_col : na, title="Session Background")

// ─────────────────────────────────────────────────────────────────────────────
//  PLOT — pannello inferiore
// ─────────────────────────────────────────────────────────────────────────────

// Zero line e bande ±0.5 (riferimento visivo)
hline(0,    "Zero",    color=color.new(color.gray, 30), linestyle=hline.style_dashed, linewidth=1)
hline(0.5,  "+0.5",   color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(-0.5, "-0.5",   color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(1.0,  "+1",     color=color.new(color.gray, 85), linestyle=hline.style_dotted)
hline(-1.0, "-1",     color=color.new(color.gray, 85), linestyle=hline.style_dotted)

// Ciclo oscillatore (linea principale)
p_cycle = plot(cycle_norm, "Cycle Oscillator", color=cycle_color, linewidth=2)

// Riempimento sopra/sotto lo zero
p_zero  = plot(0.0, display=display.none)
fill(p_cycle, p_zero,
     top_value    =  1.0,
     bottom_value =  0.0,
     top_color    = color.new(bull_col, 88),
     bottom_color = color.new(bull_col, 98),
     title="Bull Fill")
fill(p_cycle, p_zero,
     top_value    =  0.0,
     bottom_value = -1.0,
     top_color    = color.new(bear_col, 98),
     bottom_color = color.new(bear_col, 88),
     title="Bear Fill")

// Periodo dominante (opzionale, scalato per stare nel pannello)
float period_scaled = show_period and not na(dom_period) ? (dom_period / N) * 0.8 - 0.9 : na
plot(period_scaled, "Dom Period (scaled)", color=color.new(#ff9800, 50), linewidth=1,
     style=plot.style_line, title="Dominant Period")

// SNR (opzionale, scalato)
float snr_scaled = show_snr and not na(snr_out) ? math.min(snr_out / 8.0, 1.0) * 0.5 - 1.0 : na
plot(snr_scaled, "SNR (scaled)", color=color.new(#9c27b0, 60), linewidth=1,
     style=plot.style_line, title="SNR")

// Segnali nel pannello
plotshape(long_sig  ? -0.75 : na, "Long Signal",
     shape=shape.triangleup, location=location.absolute,
     color=bull_col, size=size.small, title="Long")
plotshape(short_sig ?  0.75 : na, "Short Signal",
     shape=shape.triangledown, location=location.absolute,
     color=bear_col, size=size.small, title="Short")

// Marker per segnali senza quality gate (visibilità)
plotshape(long_raw  and not quality and in_session ? -0.6 : na, "Long (weak)",
     shape=shape.circle, location=location.absolute,
     color=color.new(bull_col, 60), size=size.tiny, title="Long weak")
plotshape(short_raw and not quality and in_session ?  0.6 : na, "Short (weak)",
     shape=shape.circle, location=location.absolute,
     color=color.new(bear_col, 60), size=size.tiny, title="Short weak")

// ─────────────────────────────────────────────────────────────────────────────
//  DATA WINDOW  (visibile nel pannello dati di TradingView)
// ─────────────────────────────────────────────────────────────────────────────
plot(dom_period,  "Dominant Period (bars)", display=display.data_window + display.none)
plot(snr_out,     "SNR",                    display=display.data_window + display.none)
plot(cycle_norm,  "Cycle [-1,+1]",          display=display.data_window + display.none)

// ─────────────────────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(long_sig,
     title="FFT-DC Long",
     message="FFT Dominant Cycle — LONG  |  Period={{plot_0}}b  SNR={{plot_1}}")

alertcondition(short_sig,
     title="FFT-DC Short",
     message="FFT Dominant Cycle — SHORT  |  Period={{plot_0}}b  SNR={{plot_1}}")

alertcondition(long_sig or short_sig,
     title="FFT-DC Any Signal",
     message="FFT Dominant Cycle — SIGNAL")
